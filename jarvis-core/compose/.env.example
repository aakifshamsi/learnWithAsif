# Jarvis Core — Docker Compose environment
# Copy this to .env and fill in your values

# Your domain
DOMAIN=sham.si

# Open WebUI
WEBUI_SECRET_KEY=CHANGE_ME_LONG_RANDOM_STRING
WEBUI_ENABLE_SIGNUP=false

# Nextcloud
NEXTCLOUD_ADMIN_USER=aakif
NEXTCLOUD_ADMIN_PASSWORD=CHANGE_ME
NEXTCLOUD_TRUSTED_DOMAINS=cloud.sham.si localhost

# Gitea
GITEA_ADMIN_USER=aakif
GITEA_ADMIN_PASSWORD=CHANGE_ME
GITEA_ADMIN_EMAIL=aakif@sham.si

# Qdrant
QDRANT_API_KEY=CHANGE_ME

# Nginx Proxy Manager
# (configure via UI at http://localhost:81)
NPM_DEFAULT_EMAIL=aakif@sham.si

# Uptime Kuma
# (configure via UI, no env needed)

# Ollama host (running on host, not in Docker)
OLLAMA_BASE_URL=http://host-gateway:11434

# Whisper API
WHISPER_MODEL=base.en

# Ports (change if conflicts)
PORT_WEBUI=3000
PORT_NEXTCLOUD=8080
PORT_GITEA=3001
PORT_QDRANT=6333
PORT_NPM_UI=81
PORT_NPM_HTTP=80
PORT_NPM_HTTPS=443
PORT_PORTAINER=9000
PORT_KUMA=3002
PORT_WHISPER=9090
